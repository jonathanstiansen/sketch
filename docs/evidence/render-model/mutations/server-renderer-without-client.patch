diff --git a/lib/sketch_web/elements/ellipse.ex b/lib/sketch_web/elements/ellipse.ex
new file mode 100644
index 0000000..48703ae
--- /dev/null
+++ b/lib/sketch_web/elements/ellipse.ex
@@ -0,0 +1,21 @@
+defmodule SketchWeb.Elements.Ellipse do
+  @moduledoc "Renders an ellipse inscribed in its box."
+  @behaviour SketchWeb.ElementRenderer
+
+  @impl true
+  def render(%{width: width, height: height}) do
+    [
+      %{
+        tag: "ellipse",
+        attrs: [
+          {"cx", width / 2},
+          {"cy", height / 2},
+          {"rx", width / 2},
+          {"ry", height / 2},
+          {"stroke-width", 2},
+          {"class", "fill-primary stroke-base-content"}
+        ]
+      }
+    ]
+  end
+end
