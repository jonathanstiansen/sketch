diff --git a/assets/js/hooks/canvas.ts b/assets/js/hooks/canvas.ts
index 374c1d6..27991d0 100644
--- a/assets/js/hooks/canvas.ts
+++ b/assets/js/hooks/canvas.ts
@@ -546,6 +546,11 @@ export class Canvas extends ViewHook {
     this.handleEvent("drag_cancel", (payload: unknown) => {
       if (isDragRef(payload)) this.cancelRemoteDrag(payload)
     })
+    this.handleEvent("selection", (payload: unknown) => {
+      if (!isRecord(payload) || !Array.isArray(payload.element_ids)) return
+      const rects = payload.element_ids.flatMap((id) => (typeof id === "string" ? (this.elementFor(id) ?? []) : []))
+      this.selection.showGroup(rects.map(renderedBox))
+    })
     this.handleEvent("group_preview", (payload: unknown) => {
       if (isGroupPreview(payload)) this.applyRemoteGroup(payload)
     })
@@ -1484,6 +1489,7 @@ export class Canvas extends ViewHook {
       this.js().setAttribute(this.el, SELECTED_ATTRIBUTE, this.selected.join(" "))
       this.js().setAttribute(this.el, SELECTED_COUNT_ATTRIBUTE, String(rects.length))
       this.showSelection(only, rects)
+      if (this.online) void this.pushEvent("selection", { element_ids: this.selected })
     }
     this.syncStylePanel()
   }
